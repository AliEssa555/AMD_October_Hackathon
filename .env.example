# Copy to .env and fill in. .env is gitignored (hard rule 0.3) -- never commit it.

# ---------------------------------------------------------------- DigitalOcean
# Full-access token. Laptop + GitHub Actions secrets ONLY.
# Must be created in the team whose Billing page shows the $100 credit (spec 8.1).
DIGITALOCEAN_ACCESS_TOKEN=
# Custom-scoped token: droplet read + delete only. This is the ONLY DO token
# that is ever placed in GPU-Droplet user-data (spec 8.5).
DO_SELF_DESTROY_TOKEN=
# Verified 17 Oct 2026 from the live devcloud.amd.com "Create GPU Droplet" form.
DO_REGION=atl1                    # Atlanta DC1. RIC1 shows "GPUs currently unavailable".
DO_VPC_UUID=
DO_SSH_KEY_FINGERPRINT=           # console shows one key, "test", id 60164577
DO_PROJECT_UUID=fa26874e-0012-4b24-8af4-24d2a2a1de3a   # project "My AMD Home"
GPU_SIZE_SLUG=gpu-mi300x1-192gb-devcloud   # MI300X x1: 192GB VRAM, 20 vCPU, 240GB RAM,
                                  # 720GB boot + 5TB scratch NVMe. The x8 plan is greyed out.
# Images are numeric IDs on this console, not slugs. Verify with
#   doctl compute image list --public | grep -i rocm
GPU_IMAGE_SLUG=194144122          # PyTorch 2.6.0 on ROCm 6.4.0 -- the conservative pick.
                                  # Alternatives seen in the form:
                                  #   248744676  PyTorch 2.14.0 / ROCm 10.1  (newest)
                                  #   243638832  PyTorch 2.10.0 / ROCm 7.14
                                  #   248730729  bare ROCm 10.1, no PyTorch
# Real price, NOT the $2.59 the spec assumed (see spec Section 3 correction note).
GPU_HOURLY_USD=1.99
MAX_RUNTIME_HOURS=6
REAPER_MAX_AGE_HOURS=7            # MAX_RUNTIME_HOURS + 1

# ------------------------------------------------- Spaces (S3-compatible) ----
SPACES_BUCKET=yolo-der-xxxxxx
SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=                # Spaces access key; boto3/DVC/MLflow read these names
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1      # dummy value; boto3 requires one
MLFLOW_S3_ENDPOINT_URL=https://<region>.digitaloceanspaces.com

# ---------------------------------------------------------------- MLflow -----
# On the GPU Droplet: http://<hub-private-ip>:5000
# From laptop/Colab through the SSH tunnel: http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=yolo-der-exdark

# ---------------------------------------------------------------- Hub -------
HUB_PUBLIC_IP=
HUB_PRIVATE_IP=
SITE_ADDRESS=                     # <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
API_IMAGE=ghcr.io/<owner>/yolo-der-api:latest

# ---------------------------------------------------------------- Repo ------
GIT_REPO_URL=https://github.com/AliEssa555/AMD_October_Hackathon.git

# ---------------------------------------------------------------- Data ------
ROBOFLOW_API_KEY=

# ---------------------------------------------------------------- Local -----
RUNS_DIR=runs
